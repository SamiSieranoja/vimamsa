#!/usr/bin/env ruby
require "ripl/multi_line"
require "tempfile"
# Ripl.config[:multi_line_prompt] = ' > '
require "pathname"

selfpath = __FILE__
selfpath = File.readlink(selfpath) if File.lstat(selfpath).symlink?
scriptdir = File.expand_path(File.dirname(selfpath) + "/..")

# --user-dir PATH (or --user-dir=PATH): use PATH as the config/data directory
# instead of ~/.config/vimamsa. Consumed here (and removed from ARGV) so it is
# available before anything reads the user dir, including the listen check below.
if (i = ARGV.index("--user-dir"))
  $vma_user_dir = File.expand_path(ARGV[i + 1]) if ARGV[i + 1]
  ARGV.slice!(i, 2)
elsif (arg = ARGV.find { |a| a.start_with?("--user-dir=") })
  $vma_user_dir = File.expand_path(arg.split("=", 2)[1])
  ARGV.delete(arg)
end
$vma_user_dir ||= File.expand_path("~/.config/vimamsa")

# --intro: show the introduction page at start (intro_page.rb), whatever the
# settings say. Removed from ARGV so it isn't taken for a file name.
$vma_show_intro = !ARGV.delete("--intro").nil?

# --help / -h: the options and the actions (cli_help.rb), then exit
$vma_cli_help = [ARGV.delete("--help"), ARGV.delete("-h")].any?

# --tmp-user-dir: a new, empty user dir in the system temp dir, deleted on
# quit (tmp_user_dir.rb). After an editor restart the dir comes in the
# environment instead, so the new process keeps using (and deletes) it.
require File.join(scriptdir, "lib/vimamsa/tmp_user_dir")
tmp_requested = !ARGV.delete("--tmp-user-dir").nil?
if Vimamsa::TmpUserDir.ours?(ENV[Vimamsa::TmpUserDir::ENV_KEY]) && File.directory?(ENV[Vimamsa::TmpUserDir::ENV_KEY])
  $vma_tmp_user_dir = ENV.delete(Vimamsa::TmpUserDir::ENV_KEY)
elsif tmp_requested && !$vma_cli_help
  $vma_tmp_user_dir = Vimamsa::TmpUserDir.create
  puts "Temporary user dir (deleted on quit): #{$vma_tmp_user_dir}"
end
ENV.delete(Vimamsa::TmpUserDir::ENV_KEY) # not for programs the editor starts
if $vma_tmp_user_dir
  $vma_user_dir = $vma_tmp_user_dir
  # Not run on exec (restart_editor), which keeps the dir
  at_exit { Vimamsa::TmpUserDir.delete($vma_tmp_user_dir) }
end

# If process is already running, open the parameter file in the running process and exit.
listen_dir = File.join($vma_user_dir, "listen")
if File.exist?(listen_dir) and !ARGV[0].nil? and !$vma_cli_help
  tmpf = Tempfile.new("vmarun", listen_dir)
  fp = tmpf.path
  paramfn = File.expand_path(ARGV[0])
  puts paramfn
  tmpf.write(paramfn)
  tmpf.close
  tstart = Time.new
  timeout = false
  while File.exist?(fp)
    sleep 0.001
    if Time.new - tstart > 0.5
      timeout = true
      break
    end
  end
  exit(0) if !timeout
end

# Relative to this script, not the current directory: started from elsewhere
# (or from an AppImage) a "./lib" there must not be picked up.
$LOAD_PATH.unshift(File.join(scriptdir, "lib"))
$LOAD_PATH.unshift(File.join(scriptdir, "ext"))

if $vma_cli_help
  require "vimamsa/cli_help"
  Vimamsa.print_cli_usage # before loading the rest (GTK takes a while)
end

require "vimamsa"
include Vimamsa

if $vma_cli_help
  Vimamsa.print_cli_actions
  exit(0)
end

# Persist crash/segfault debug info (native stderr dump + structured reports)
# to ~/.config/vimamsa/crash/ .
Vimamsa::CrashHandler.setup

# kill / ctrl-c: quit as from the menu (session saved, a --tmp-user-dir
# deleted). The trap only sets a flag; VMAgui#monitor quits on the main loop.
%w[TERM INT].each { |sig| Signal.trap(sig) { $vma_quit_requested = true } }

# Ilib:ext
# r rbvma -e "puts VMA.new.run"
$vmag = Vimamsa::VMAgui.new()
$vmag.run
