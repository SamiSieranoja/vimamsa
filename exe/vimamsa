#!/usr/bin/env ruby
# No garbage collection while starting up: it only collects temporaries of
# the loading, and costs about 0.25 s. Editor#start turns it back on in its
# first idle (peak memory is about 80 MB higher until then).
GC.disable
# Registered first, so it runs last of the at_exit handlers (they run in
# reverse order): with $vma_skip_exit_finalizers set (see the end of this
# file), leave without Ruby's exit-time GC finalizers, after every other
# at_exit handler has run. Their only job left is freeing memory.
at_exit {
  if $vma_skip_exit_finalizers
    $stdout.flush
    $stderr.flush
    code = $!.is_a?(SystemExit) ? $!.status : ($! ? 1 : 0)
    exit!(code)
  end
}
require "ripl/multi_line"
require "tempfile"
# Ripl.config[:multi_line_prompt] = ' > '
require "pathname"

selfpath = __FILE__
selfpath = File.readlink(selfpath) if File.lstat(selfpath).symlink?
scriptdir = File.expand_path(File.dirname(selfpath) + "/..")

# Config and data dirs (user_dirs.rb): ~/.config/vimamsa and
# ~/.local/share/vimamsa by default (the XDG dirs)
require File.join(scriptdir, "lib/vimamsa/user_dirs")

# --user-dir PATH (or --user-dir=PATH): use PATH as the config and data
# directory instead of those two. Consumed here (and removed from ARGV) so it is
# available before anything reads the user dir, including the listen check below.
if (i = ARGV.index("--user-dir"))
  $vma_user_dir = File.expand_path(ARGV[i + 1]) if ARGV[i + 1]
  ARGV.slice!(i, 2)
elsif (arg = ARGV.find { |a| a.start_with?("--user-dir=") })
  $vma_user_dir = File.expand_path(arg.split("=", 2)[1])
  ARGV.delete(arg)
end
user_dir_given = $vma_user_dir # passed on to an editor started by --wait
$vma_user_dir ||= Vimamsa::UserDirs.default_config_dir

# --intro: show the introduction page at start (intro_page.rb), whatever the
# settings say. Removed from ARGV so it isn't taken for a file name.
$vma_show_intro = !ARGV.delete("--intro").nil?

# --help / -h: the options and the actions (cli_help.rb), then exit
$vma_cli_help = [ARGV.delete("--help"), ARGV.delete("-h")].any?

# --tmp-user-dir: a new, empty user dir in the system temp dir, deleted on
# quit (tmp_user_dir.rb). After an editor restart the dir comes in the
# environment instead, so the new process keeps using (and deletes) it.
require File.join(scriptdir, "lib/vimamsa/tmp_user_dir")
tmp_requested = !ARGV.delete("--tmp-user-dir").nil?
if Vimamsa::TmpUserDir.ours?(ENV[Vimamsa::TmpUserDir::ENV_KEY]) && File.directory?(ENV[Vimamsa::TmpUserDir::ENV_KEY])
  $vma_tmp_user_dir = ENV.delete(Vimamsa::TmpUserDir::ENV_KEY)
elsif tmp_requested && !$vma_cli_help
  $vma_tmp_user_dir = Vimamsa::TmpUserDir.create
  puts "Temporary user dir (deleted on quit): #{$vma_tmp_user_dir}"
end
ENV.delete(Vimamsa::TmpUserDir::ENV_KEY) # not for programs the editor starts
if $vma_tmp_user_dir
  $vma_user_dir = $vma_tmp_user_dir
  # Not run on exec (restart_editor), which keeps the dir
  at_exit { Vimamsa::TmpUserDir.delete($vma_tmp_user_dir) }
end

# --wait FILE: return only once FILE's buffer is closed (wait_files.rb), for
# git's core.editor. --wait-marker MARKER: internal, the editor that --wait
# starts when none is running.
require File.join(scriptdir, "lib/vimamsa/wait_files")
wait_requested = !ARGV.delete("--wait").nil?
if (i = ARGV.index("--wait-marker"))
  $vma_wait_marker = ARGV[i + 1]
  ARGV.slice!(i, 2)
end
# A --tmp-user-dir editor is new and private: it is the one waited on anyway,
# as this process lasts until it quits
wait_requested = false if $vma_tmp_user_dir || $vma_cli_help

data_dir = Vimamsa::UserDirs.data_dir_for($vma_user_dir)
listen_dir = File.join(data_dir, "listen")

# Hand text (file paths, one per line) to the running editor. True when it took
# the request: it deletes the request file within the timeout.
def vma_forward_to_running(listen_dir, text, timeout: 0.5)
  tmpf = Tempfile.new("vmarun", listen_dir)
  fp = tmpf.path
  tmpf.write(text)
  tmpf.close
  tstart = Time.new
  while File.exist?(fp)
    sleep 0.001
    if Time.new - tstart > timeout
      # Take the request back, so an editor that answers late doesn't open the
      # file as well as the one about to be started
      File.delete(fp) rescue nil
      return false
    end
  end
  true
end
# TODO: comment char auto detection It does not work for this file. (gets //)
# COMMENT: Describe with one line what the code does
# COMMENT: This should be a separate function

if wait_requested
  if ARGV[0].nil?
    warn "vimamsa: --wait needs a file"
    exit(2)
  end
  paramfn = File.expand_path(ARGV[0])
  marker = Vimamsa::WaitFiles.create_marker(data_dir)
  at_exit { Vimamsa::WaitFiles.release(marker) }
  taken = File.exist?(listen_dir) &&
          vma_forward_to_running(listen_dir, Vimamsa::WaitFiles.request_text([paramfn], marker))
  if !taken
    # No editor running: start one in the background (it outlives this
    # process, and its output doesn't go to the caller's terminal)
    args = [RbConfig.ruby, File.expand_path(selfpath)]
    args += ["--user-dir", user_dir_given] if user_dir_given
    args += ["--wait-marker", marker, paramfn]
    # git's own variables (GIT_DIR, GIT_INDEX_FILE, ...) are for this commit,
    # not for an editor that keeps running
    env = ENV.keys.select { |k| k.start_with?("GIT_") }.to_h { |k| [k, nil] }
    pid = Process.spawn(env, *args, pgroup: true, in: File::NULL, out: File::NULL, err: File::NULL)
    Process.detach(pid)
    File.write(marker, pid.to_s) # until the editor writes its own pid
  end
  if Vimamsa::WaitFiles.wait_for_release(marker)
    exit(0)
  else
    warn "vimamsa: the editor quit before #{paramfn} was closed"
    exit(1)
  end
end

# Piped input (`ls | vimamsa`): a new buffer with it, in the running editor if
# there is one (stdin_input.rb). Not for test runs or an editor started by --wait.
require File.join(scriptdir, "lib/vimamsa/stdin_input")
if !$vma_cli_help && !$vma_wait_marker && !ARGV.include?("--test")
  $vma_stdin_file = Vimamsa::StdinInput.capture(data_dir)
  if $vma_stdin_file && File.exist?(listen_dir) &&
     vma_forward_to_running(listen_dir, Vimamsa::StdinInput.request_text($vma_stdin_file))
    # The running editor took it; a file argument goes there too (below)
    exit(0) if ARGV[0].nil?
    $vma_stdin_file = nil
  end
end

# If process is already running, open the parameter file in the running process and exit.
# Not for an editor started by --wait: it is the one the file is for (and
# forwarding to a slow running editor would end this process, which the
# launcher takes as the editor quitting)
if File.exist?(listen_dir) and !ARGV[0].nil? and !$vma_cli_help and !$vma_wait_marker
  paramfn = File.expand_path(ARGV[0])
  puts paramfn
  exit(0) if vma_forward_to_running(listen_dir, paramfn)
end

# Relative to this script, not the current directory: started from elsewhere
# (or from an AppImage) a "./lib" there must not be picked up.
$LOAD_PATH.unshift(File.join(scriptdir, "lib"))
$LOAD_PATH.unshift(File.join(scriptdir, "ext"))

if $vma_cli_help
  require "vimamsa/cli_help"
  Vimamsa.print_cli_usage # before loading the rest (GTK takes a while)
end

require "vimamsa"
include Vimamsa

if $vma_cli_help
  Vimamsa.print_cli_actions
  exit(0)
end

# Persist crash/segfault debug info (native stderr dump + structured reports)
# to the crash dir in the data dir (~/.local/share/vimamsa/crash/).
Vimamsa::CrashHandler.setup

# kill / ctrl-c: quit as from the menu (session saved, a --tmp-user-dir
# deleted). The trap only sets a flag; VMAgui#monitor quits on the main loop.
%w[TERM INT].each { |sig| Signal.trap(sig) { $vma_quit_requested = true } }

# Ilib:ext
# r rbvma -e "puts VMA.new.run"
$vmag = Vimamsa::VMAgui.new()
$vmag.run
# Newer GTK than 4.14 (seen with 4.24, the optional gtk-new AppImage,
# doc/appimage_old_base_plan.md): finalizing the widgets Ruby still holds,
# after GTK has shut down, crashes in gtk_text_view_dispose. The editor has
# quit by now (session saved), so skip the finalizers (see the top of this file).
$vma_skip_exit_finalizers = Gtk::Version.or_later?(4, 15)
